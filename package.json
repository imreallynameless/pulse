{
  "name": "pulse-fitbit",
  "version": "0.1.0",
  "private": true,
  "description": "An embeddable heart-rate widget: Google Health latest measurements or direct Bluetooth streaming.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test",
    "setup": "node scripts/setup.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "deploy:cloud": "npm run build:cloud && wrangler deploy"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "wrangler": "4.151.1"
  }
}
